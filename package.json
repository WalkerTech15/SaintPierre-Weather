{
  "name": "weathersphere",
  "version": "1.0.0",
  "private": true,
  "description": "Saint-Pierre Weather — a premium, modern weather dashboard built with vanilla JS and Vite.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --host localhost --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run build && npm run verify:secrets",
    "optimize:flags": "svgo -rf public/assets/flags --multipass"
  },
  "dependencies": {
    "@maptiler/sdk": "^4.2.1",
    "@maptiler/weather": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "flag-icons": "^7.6.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
